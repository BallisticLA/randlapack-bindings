function p = external_paths()
%EXTERNAL_PATHS  Locations of the fetched (NOT vendored) benchmark baselines,
% and put them on the MATLAB path. GENERATED by CMake (FetchContent) from
% external_paths.m.in — do not edit by hand; re-run cmake to regenerate.
%
% Acknowledgements (see ../../../THIRD_PARTY_LICENSES.md):
%   Epperly  github.com/eepperly/Ethan-Epperly-Thesis  (MIT) — XTrace / XNysTrace
%            / resphering trace estimators.
%   Persson  github.com/davpersson/funNystrom  (license pending; used with
%            attribution) — nystrom.m, funnystrompp.m, block_lanczos.m
%            (block_lanczos.m is Meyer's HutchPlusPlus, vendored by Persson).
%
% Fetched at the pinned commits recorded in CMakeLists.txt.

    p.epperly = '@EPPERLY_DIR@';
    p.persson = '@PERSSON_DIR@';

    % genpath: the upstream repos nest the .m files in subdirectories
    % (Epperly under code/..., Persson under Other/), so add recursively.
    addpath(genpath(p.epperly));
    addpath(genpath(p.persson));
end
